# Header self-containment check.
#
# For every header under include/dsa/ this generates a .cpp that includes only
# that header (twice), and compiles them all as part of the normal build:
#   - a header that relies on something it didn't #include fails to compile
#     (in a test it might "borrow" the include from another header);
#   - including it twice fails if #pragma once is missing.
# Nothing is linked; the object files are the test.

file(GLOB_RECURSE _dsa_headers
    CONFIGURE_DEPENDS                    # re-glob on every build: new headers are picked up
    RELATIVE "${PROJECT_SOURCE_DIR}/include"
    "${PROJECT_SOURCE_DIR}/include/dsa/*.hpp")

set(_dsa_sc_sources "")
foreach(header IN LISTS _dsa_headers)
    # dsa/detail/assert.hpp -> <build>/selfcontained/dsa/detail/assert.hpp.cpp
    set(tu "${CMAKE_CURRENT_BINARY_DIR}/selfcontained/${header}.cpp")
    # file(CONFIGURE) only rewrites the file when the content changes,
    # so unchanged headers aren't recompiled on every reconfigure.
    file(CONFIGURE OUTPUT "${tu}" CONTENT
"// Generated by cmake/SelfContained.cmake. Do not edit.
#include <@header@>
#include <@header@>
")
    list(APPEND _dsa_sc_sources "${tu}")
endforeach()

add_library(dsa_selfcontained OBJECT ${_dsa_sc_sources})
target_link_libraries(dsa_selfcontained PRIVATE dsa::dsa dsa_warnings dsa_sanitizers)
